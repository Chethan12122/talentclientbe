{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "rootDir": "app",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
  },
  "include": ["app"],
  "exclude": ["node_modules", "dist", "tests"]
}
