{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "rootDir": "app",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "sourceMap": true, // Enables generation of source maps
    "inlineSources": true,
    "types": ["node"], // Ensure Node.js types
    "baseUrl": "."
  },
  
  "include": ["app"],
  "exclude": ["node_modules", "dist", "tests"]
}
